# Vorlage. Kopie als deploy/env (ohne .example) anlegen -- die ist gitignored.
# backup.sh und deploy.sh lesen sie automatisch, kein export nötig.

GYM_FTP_HOST=ftp://ftp.example.com
GYM_FTP_USER=your-ftp-user
GYM_FTP_PASS=

# App-URL — damit deploy.sh die Migration selbst auslösen kann
GYM_APP_URL=http://gym.example.com
